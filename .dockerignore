# Only exclude heavy/unnecessary directories
node_modules

# Exclude downloaded cache (will be re-fetched inside container)
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml

# IMPORTANT: Do NOT ignore these — Yarn Berry needs them:
# .yarn/releases  (the Yarn binary)
# .yarn/patches   (package patches)
# .yarnrc.yml     (Yarn config)
# package.json    (obviously needed)
# yarn.lock       (dependency lock file)

# Git history
.git

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.*

# Docker files
docker-compose.yml
nginx/
